<Window x:Class="DiametroLineaDesktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RazorGauge"
        Icon="/Assets/icon.ico"
        Height="934"
        Width="1400"
        MinHeight="814"
        MinWidth="900"
        Background="#12151C"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="StripBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#7A8499"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232837"/>
                                <Setter Property="Foreground" Value="#E2E8F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Border x:Name="StripBorder" Grid.Row="0" Background="#0D0F16"
                BorderBrush="#2E3548" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,4,8,4">
                    <Button x:Name="SplitBtn" Style="{StaticResource StripBtn}"
                            Content="◫  Side by side" Click="SplitBtn_Click"
                            ToolTip="Show two tabs side by side (or drag a tab onto the right half)"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel" x:Name="TabScroll">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
                        <Button Style="{StaticResource StripBtn}" Content="+" FontSize="16"
                                Margin="4,4,0,4" Padding="9,0" Click="NewTab_Click"
                                ToolTip="New tab (Ctrl+T)"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Tab contents: every open view lives here; only the shown ones are visible. -->
        <Grid x:Name="ContentHost" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#2E3548" Visibility="Collapsed" Panel.ZIndex="10"
                          ResizeBehavior="PreviousAndNext"/>
            <!-- Drop hint while dragging a tab over the right half -->
            <Border x:Name="DropHint" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="20"
                    HorizontalAlignment="Right" Background="#332D7DD2" BorderBrush="#2D7DD2"
                    BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
