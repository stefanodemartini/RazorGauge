<Window
    x:Class="DiametroLineaDesktop.Views.CompensateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Compensate"
    Width="380" SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#12151C"
    FontFamily="Segoe UI"
    ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent"      Color="#2D7DD2"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F4"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#7A8499"/>
        <SolidColorBrush x:Key="BorderCol"   Color="#2E3548"/>
        <SolidColorBrush x:Key="InputBg"     Color="#232837"/>
    </Window.Resources>

    <Border Background="#1C2030" BorderBrush="#2E3548" BorderThickness="1" Margin="1">
        <StackPanel Margin="20">

            <!-- Heading -->
            <TextBlock Text="Compensate — target sink speed"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Every section is re-solved (mass-preserving, per 1 cm slice) so the whole line sinks at the same speed. The result is written to a separate C file — this design is not modified."
                       FontSize="11" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MinLabel" Grid.Column="0" Text="—" FontSize="10"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <Slider x:Name="SpeedSlider" Grid.Column="1"
                        IsMoveToPointEnabled="True"
                        SmallChange="0.005" LargeChange="0.05"
                        ValueChanged="SpeedSlider_ValueChanged"
                        Margin="8,0"/>
                <TextBlock x:Name="MaxLabel" Grid.Column="2" Text="—" FontSize="10"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="SpeedValueLabel" Text="—"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}"
                       HorizontalAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="The slider range is the slowest-to-fastest sink speed the current sections already reach — any target inside it is achievable by changing density alone."
                       FontSize="10" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <Rectangle Height="1" Fill="#2E3548" Margin="0,18,0,14"/>

            <!-- Nozzle count: each nozzle is one real material (density) -->
            <TextBlock x:Name="NozzleHeading" Text="Nozzles (materials)" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
            <Grid x:Name="NozzleChoiceGrid">
                <Grid.Resources>
                    <Style TargetType="RadioButton">
                        <Setter Property="Foreground" Value="#E2E8F4"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <EventSetter Event="Checked" Handler="NozzleRadio_Checked"/>
                    </Style>
                    <Style x:Key="Cell" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#7A8499"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="ColorCol" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Cell}" Grid.Row="0" Grid.Column="1" Text="worst" Margin="0,0,14,2"/>
                <TextBlock Style="{StaticResource Cell}" Grid.Row="0" Grid.Column="2" Text="mean"  Margin="0,0,0,2"/>
                <RadioButton x:Name="Noz2" Grid.Row="1" Content="2 nozzles" Tag="2" GroupName="Noz"/>
                <RadioButton x:Name="Noz3" Grid.Row="2" Content="3 nozzles" Tag="3" GroupName="Noz"/>
                <RadioButton x:Name="Noz4" Grid.Row="3" Content="4 nozzles" Tag="4" GroupName="Noz"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Worst2" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,0,14,0"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Worst3" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,0,14,0"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Worst4" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,0,14,0"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Mean2"  Grid.Row="1" Grid.Column="2" Text="—"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Mean3"  Grid.Row="2" Grid.Column="2" Text="—"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Mean4"  Grid.Row="3" Grid.Column="2" Text="—"/>
                <TextBlock Style="{StaticResource Cell}" Grid.Row="0" Grid.Column="3" Text="colors" Margin="14,0,0,2"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Col2" Grid.Row="1" Grid.Column="3" Text="—" Margin="14,0,0,0"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Col3" Grid.Row="2" Grid.Column="3" Text="—" Margin="14,0,0,0"/>
                <TextBlock Style="{StaticResource Cell}" x:Name="Col4" Grid.Row="3" Grid.Column="3" Text="—" Margin="14,0,0,0"/>
            </Grid>
            <TextBlock x:Name="NozzleNote" Text="Sink speed deviation from the target (in/s) of the line that would be written. Fewer nozzles = simpler extrusion, larger deviation."
                       FontSize="10" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <!-- Densities that coincide at 2 decimals: fewer real materials than chosen -->
            <TextBlock x:Name="MergeWarning" Visibility="Collapsed"
                       FontSize="11" Foreground="#F5B942"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Rectangle Height="1" Fill="#2E3548" Margin="0,18,0,14"/>

            <TextBlock Text="Will be saved as:" FontSize="10"
                       Foreground="{StaticResource TextMuted}"/>
            <TextBlock x:Name="FileNameLabel" Text="—"
                       FontSize="11" Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>

            <Rectangle Height="1" Fill="#2E3548" Margin="0,14,0,14"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Create C file"
                        Click="OkBtn_Click" IsDefault="True"
                        Width="110" Height="30"
                        FontSize="12" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#2D7DD2" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.62"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Cancel"
                        Click="CancelBtn_Click"
                        IsCancel="True"
                        Width="90" Height="30"
                        FontSize="12"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#232837"
                                    BorderBrush="#2E3548" BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.Foreground="#7A8499"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
