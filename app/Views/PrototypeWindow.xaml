<Window
        x:Class="DiametroLineaDesktop.Views.PrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:DiametroLineaDesktop.Views"
        Title="Prototype — assemble from pieces"
        Icon="pack://application:,,,/FlyLineProfiler;component/Assets/icon.ico"
        Height="880" Width="1440" MinHeight="600" MinWidth="900"
        Background="#12151C"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg"      Color="#1C2030"/>
        <SolidColorBrush x:Key="CardBg"       Color="#232837"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#2E3548"/>
        <SolidColorBrush x:Key="Accent"       Color="#2D7DD2"/>
        <SolidColorBrush x:Key="AccentDim"    Color="#1A4F8A"/>
        <SolidColorBrush x:Key="Warning"      Color="#F5A623"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#E2E8F4"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#7A8499"/>

        <local:HexToBrushConverter x:Key="HexToBrush"/>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#2C3245"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.80"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.60"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.30"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="ToggleBase" TargetType="ToggleButton">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#2C3245"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.80"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolSep" TargetType="Separator">
            <Setter Property="Width" Value="1"/><Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="8,0"/><Setter Property="Background" Value="#2E3548"/>
        </Style>
        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#1A1E2A"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush2}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding"         Value="4,3"/>
        </Style>

        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background"               Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="RowBackground"            Value="{StaticResource PanelBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource CardBg}"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2E3548"/>
            <Setter Property="ColumnHeaderHeight"       Value="26"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="CanUserReorderColumns"    Value="False"/>
            <Setter Property="CanUserSortColumns"       Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDim}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="8,6">
            <!-- Wraps to a second row when the window is narrower than the toolbar. -->
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Name" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <TextBox x:Name="NameBox" Width="200" Height="26" Style="{StaticResource DarkBox}" VerticalAlignment="Center" TextChanged="NameBox_TextChanged"/>
                <Separator Style="{StaticResource ToolSep}"/>
                <Button Content="New"      Style="{StaticResource BtnGhost}" Click="New_Click"/>
                <Button Content="Open…"    Style="{StaticResource BtnBase}"  Click="Open_Click"/>
                <Button Content="Save"     Style="{StaticResource BtnBase}"  Click="Save_Click" ToolTip="Save the prototype (.flproto) — pieces stay editable"/>
                <Button Content="Save As…" Style="{StaticResource BtnGhost}" Click="SaveAs_Click"/>
                <Separator Style="{StaticResource ToolSep}"/>
                <Button Content="Undo"     Style="{StaticResource BtnGhost}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"/>
                <Button Content="⇄ Flip 180°" Style="{StaticResource BtnBase}" Click="Flip_Click" ToolTip="Flip the selected piece end for end (F)"/>
                <Button Content="✂ Split…"    Style="{StaticResource BtnBase}"  Click="SplitSelected_Click" ToolTip="Split the selected piece into equal parts (or: right-click / S on the chart to split at the cursor)"/>
                <Button Content="Reset cuts"  Style="{StaticResource BtnGhost}" Click="ResetCuts_Click" ToolTip="Restore the selected piece to its full length"/>
                <Button Content="Remove"      Style="{StaticResource BtnGhost}" Click="Remove_Click" ToolTip="Remove the selected piece (Del)"/>
                <Button Content="Close gaps"  Style="{StaticResource BtnGhost}" Click="CloseGaps_Click" ToolTip="Slide pieces left so each one starts where the previous one ends"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"
                            ToolTip="Extra line each piece needs at every joined end (core exposed for the needle splice). Added to the bench cuts, not to the finished line.">
                    <TextBlock Text="Splice" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="AllowanceBox" Width="38" Height="26" Style="{StaticResource DarkBox}" VerticalAlignment="Center"
                             HorizontalContentAlignment="Right" LostFocus="AllowanceBox_Commit" KeyDown="AllowanceBox_KeyDown"/>
                    <TextBlock Text="cm / end" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <Button Content="Fit"         Style="{StaticResource BtnGhost}" Click="Fit_Click"/>
                <ToggleButton x:Name="OriginalShapeToggle" Content="Original shape" Style="{StaticResource ToggleBase}" IsChecked="True"
                              Click="OriginalShape_Click" ToolTip="Show each piece's full original shape as a dashed outline — split parts included"/>
                <Separator Style="{StaticResource ToolSep}"/>
                <Button Content="Copy cut list"   Style="{StaticResource BtnGhost}" Click="CopyCutList_Click"/>
                <Button Content="Export .flp…"    Style="{StaticResource BtnBase}"  Click="ExportFlp_Click" ToolTip="Save the finished line as an ordinary project (its scan = the assembled profile)"/>
                <Button Content="Open in Profiler" Style="{StaticResource BtnPrimary}" Click="OpenInProfiler_Click" ToolTip="Export and open the finished line in the main window"/>
            </WrapPanel>
        </Border>

        <!-- ── Library + chart ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBg}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="↻" Style="{StaticResource BtnGhost}" Height="24" Padding="8,0" Click="RefreshLibrary_Click" ToolTip="Rescan the library folder"/>
                        <Button DockPanel.Dock="Right" Content="Folder…" Style="{StaticResource BtnGhost}" Height="24" Padding="8,0" Click="ChangeLibrary_Click" ToolTip="Choose the library folder (also in Settings)"/>
                        <TextBlock Text="PIECE LIBRARY" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" x:Name="LibraryFolderText" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>
                    <TextBox Grid.Row="2" x:Name="LibraryFilterBox" Style="{StaticResource DarkBox}" Margin="0,0,0,6" TextChanged="LibraryFilter_TextChanged" ToolTip="Filter by name or folder"/>
                    <ListBox Grid.Row="3" x:Name="LibraryList" Background="#161922" BorderBrush="{StaticResource BorderBrush2}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="LibraryList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3" ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Folder}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                    <Path Data="{Binding Thumbnail}" Fill="#3A5A8A" Stroke="#6FA0E0" StrokeThickness="0.8" Margin="0,3,0,1" Width="200" Height="28" Stretch="None" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="Consolas"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="4" Content="Add to prototype →" Style="{StaticResource BtnPrimary}" Margin="0,6,0,0" Click="AddPiece_Click" ToolTip="Or double-click a piece"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#12151C"/>

            <ScottPlot:WpfPlot Grid.Column="2" x:Name="Chart" Margin="4"/>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#12151C"/>

        <!-- ── Pieces table + cut list ────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="6,0,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="PiecesGrid" Style="{StaticResource DarkGrid}"
                      SelectionChanged="PiecesGrid_SelectionChanged"
                      CellEditEnding="PiecesGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="24" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="Swatch_Click" Cursor="Hand" ToolTip="Change colour" Padding="0" BorderThickness="0" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="2">
                                                <Rectangle Width="12" Height="12" Stroke="#7A8499" StrokeThickness="0.5"
                                                           Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#"      Binding="{Binding Number}"    IsReadOnly="True" Width="28"/>
                    <DataGridTextColumn Header="Piece"  Binding="{Binding Name}"      IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Dir"    Binding="{Binding Direction}" IsReadOnly="True" Width="70"/>
                    <DataGridTextColumn Header="Full (cm)"       Binding="{Binding FullCm, StringFormat=0}"  IsReadOnly="True" Width="70"/>
                    <DataGridTextColumn Header="Trim scan-start" Binding="{Binding CutStart, StringFormat=0.#}" Width="110"/>
                    <DataGridTextColumn Header="Trim scan-end"   Binding="{Binding CutEnd, StringFormat=0.#}"   Width="100"/>
                    <DataGridTextColumn Header="In line (cm)"    Binding="{Binding KeptCm, StringFormat=0.#}"   IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="Cut length"      Binding="{Binding CutLengthCm, StringFormat=0.#}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Ø left"          Binding="{Binding DLeft, StringFormat=0.00}"   IsReadOnly="True" Width="55"/>
                    <DataGridTextColumn Header="Ø right"         Binding="{Binding DRight, StringFormat=0.00}"  IsReadOnly="True" Width="58"/>
                    <DataGridTextColumn Header="ρ g/cm³"         Binding="{Binding Density, StringFormat=0.000}" Width="65"/>
                    <DataGridTextColumn Header="Mass (g)"        Binding="{Binding MassText}"                    IsReadOnly="True" Width="65"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CUT LIST" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,2,0,4"/>
                <TextBox Grid.Row="1" x:Name="CutListBox" Style="{StaticResource DarkBox}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                <ScrollViewer Grid.Row="2" MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <TextBlock x:Name="WarningsText" Foreground="{StaticResource Warning}" FontSize="11" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="{StaticResource PanelBg}" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="TotalsText" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
