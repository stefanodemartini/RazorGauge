# .NET build output
app/bin/
app/obj/
app/publish_test/
publish/

# Visual Studio / Rider
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Arduino IDE temp files
*.bak

# CLI build output
cli/bin/
cli/obj/

# FlyLinePhysics build output
FlyLinePhysics/bin/
FlyLinePhysics/obj/
FlyLinePhysics.Tests/bin/
FlyLinePhysics.Tests/obj/

# ── CAD, scheda, documenti: si versionano i sorgenti, non cio che se ne rigenera ───────
# SCAD, KiCad, script e documenti stanno in pochi MB; mesh, render e PDF sono
# ~90 MB che gli script in strumenti/ riproducono.
*.stl
*.3mf
*.glb
*.dxf
*.step
*.stp
*.png
*.jpg
*.jpeg
*.pdf
*.html
_archivio_NON_USARE/
# Cronologia locale di VS Code: contiene repository annidati, git rifiuta di aggiungerli
.history/

# File volatili di KiCad: stato utente, cache, backup automatici
*.kicad_prl
*-backups/
fp-info-cache
*.bak

# Python
__pycache__/
*.pyc

# Immagini e installer locali (non rigenerabili dagli script, ma pesanti: restano fuori dal repo)
immagini/

# Output di compilazione del firmware (Arduino CLI)
master_razorgauge/build/

# ── Eccezioni (19/11/2026): file NON rigenerabili o CONGELATI perche' gia' inviati ai fornitori ──
# Sorgenti esterni da cui partono gli script (senza questi strumenti/ non ricostruisce nulla)
!Stl_esterrni/*.stl
!cad/sensor.stl
!integrazione_profiler/FlylineProfiler_V3_1_originale.stl
!integrazione_profiler/FlylineProfiler_senza_comparatore.stl
!integrazione_profiler/porta_rullo_spintore_originale.stl
!integrazione_profiler/FlylineProfiler_porta_rullo_guidato.stl
# Versione congelata inviata a JLC3DP (ordine MJF del 05/11/2026)
!integrazione_profiler/kit_stampa_stl/*.stl
# Disegni e file inviati per la lavorazione CNC (ruota encoder compresa)
!piastra_alluminio/cnc/*.step
!piastra_alluminio/cnc/*.pdf
!piastra_alluminio/Piastre_fori.pdf
# Disegni di assieme, schemi elettrici, collegamenti e datasheet
!integrazione_profiler/RazorGauge_assieme_slitta_sensore_ruota.pdf
!integrazione_profiler/LFD650-1-12_9x20_datasheet.pdf
!scheda_sensore/*.pdf
!scheda/*.pdf
!scheda_smd/*.pdf
!RazorGauge_documento_progetto.pdf
