(text "NOTE:" (at 570 300.0 0) (effects (font (size 1.8 1.8) bold) (justify left bottom)) (uuid 0a5b8feb-fbd5-4c19-9b9f-d7fc379dc152))
(text "- Encoder spostato da GPIO12/13 a GPIO32/33 (GPIO12 e pin di avvio): aggiornare ENCODER_DATA_PIN=32, ENCODER_CLOCK_PIN=33 nel master." (at 570 305.08 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 2f4135ab-8b33-4f0b-8ed9-9203a77be4be))
(text "- TB6600 a catodo comune: PUL/DIR/ENA alti = LED opto acceso. ENA alto = motore libero (pull-up R22 = motore libero all accensione)." (at 570 310.16 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 7e45b0af-47e6-420a-bd72-1d83e8f61842))
(text "- Il motore e il TB6600 si alimentano direttamente dall alimentatore 24 V, non dalla scheda." (at 570 315.24 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 8cf63a4a-7610-42d6-a887-959a54dd63b7))
(text "- Slave = ESP32 DevKit V1 30p come il master: PUL/DIR/ENA su GPIO25/26/27, pulsanti su GPIO32/33/34, UART su GPIO16/17 (firmware slave 0.6.0)." (at 570 320.32 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 46dda39c-2bb2-4d48-81a5-77ad74a8ebd5))
(text "- D4/D5 impediscono che l USB di un modulo alimenti tutta la scheda." (at 570 325.4 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid e6379813-4b9b-48a9-91f2-d24a30b0356b))
(text "- Calza dei cavi schermati collegata a GND solo lato scheda." (at 570 330.48 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 5c111eed-be76-404c-b355-553540fb9a40))
  (sheet_instances (path "/" (page "1")))
